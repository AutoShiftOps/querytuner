# ─────────────────────────────────────────────
# QueryTuner — Backend Environment Variables
# Copy this file to .env and fill in your keys
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── HuggingFace (default AI provider, free tier) ──
HF_API_KEY=your_huggingface_api_key_here
HF_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
HF_ROUTER_BASE_URL=https://router.huggingface.co

# ── OpenAI (optional, uncomment to enable) ──
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── LLM defaults ──
DEFAULT_LLM_PROVIDER=huggingface
AI_MAX_TOKENS=1500

# ── Query limits ──
MAX_QUERY_CHARS=32000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Get from Supabase Dashboard -> Project Settings -> API -> service_role key
# (the "secret" one, not the "anon public" one above). Required now that RLS
# is enabled on analyses and user_usage — service_role bypasses RLS, which
# is what every backend read/write in database.py actually needs.
# NEVER expose this key to the frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Clerk auth (Phase 4) ──
# Publishable key — same value as frontend's VITE_CLERK_PUBLISHABLE_KEY.
# Non-secret; used server-side only to derive the Clerk JWKS URL.
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ── Stripe billing (Phase 4) ──
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PRICE_ID=price_your_price_id_here
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here

# ── Observability (Phase 5, #135) ──
# Blank = Sentry is a complete no-op (see main.py's init) — same
# degrades-gracefully pattern as every other optional key above.
# Get a DSN free at sentry.io -> Create Project -> Python/FastAPI.
# SENTRY_DSN=https://your_key@o0.ingest.sentry.io/0
ENVIRONMENT=production
# See docs/querytuner-observability-issue.md for the full setup guide,
# including the uptime-monitor and alerting steps that happen outside
# this repo entirely (nothing to set here for those).
